{
  "manifest_version": 3,
  "name": "TikTok Video Downloader HD - BT Dubber",
  "version": "1.0.0",
  "description": "ទាញយកវីដេអូ TikTok កម្រិតច្បាស់ HD គ្មាន Watermark និងទាញយកសំឡេង MP3 ដោយចុចតែម្តង (One-Click Download)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikTok Downloader HD",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "downloads",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.tikwm.com/*",
    "*://*.ssstik.io/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ]
}
